{
  "name": "@ride/desktop",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "description": "RIDE - The AI-native IDE",
  "author": "RIDE Contributors",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "turbo run build --filter=@ride/contracts --filter=@ride/ui --filter=@ride/ide-core --filter=@ride/terminal --filter=@ride/git --filter=@ride/agent-bridge --filter=@ride/model-router --filter=@ride/permissions --filter=@ride/project-db && electron-vite dev",
    "dev:watch": "node ../../scripts/dev-watch.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "start": "electron-vite preview",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder --win nsis"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "systeminformation": "^5.33.1"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@ride/agent-bridge": "workspace:*",
    "@ride/agent-core": "workspace:*",
    "@ride/contracts": "workspace:*",
    "@ride/git": "workspace:*",
    "@ride/ide-core": "workspace:*",
    "@ride/marketplace": "workspace:*",
    "@ride/model-router": "workspace:*",
    "@ride/permissions": "workspace:*",
    "@ride/plugins": "workspace:*",
    "@ride/project-db": "workspace:*",
    "@ride/terminal": "workspace:*",
    "@ride/theme": "workspace:*",
    "@ride/ui": "workspace:*",
    "@tailwindcss/vite": "^4.1.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.475.0",
    "monaco-editor": "^0.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
