{
  "name": "@ride/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RIDE Commerce + Deployment backend (Fastify + SQLite)",
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./db": "./dist/db.js",
    "./security": "./dist/security.js",
    "./catalog": "./dist/catalog.js",
    "./student": "./dist/student.js",
    "./marketplace": "./dist/marketplace/index.js",
    "./plugin-marketplace": "./dist/plugin-marketplace/index.js",
    "./deploy": "./dist/deploy/index.js",
    "./gateway": "./dist/gateway/index.js",
    "./hostinger": "./dist/hostinger.js",
    "./pricing": "./dist/pricing.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "axios": "^1.7.0",
    "fastify": "^5.2.0",
    "hostinger-api-sdk": "^0.0.4"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}